# Nyra scheduler daemon, as a systemd user service.
#
# Install: see docs/linux-systemd.md. This is a *user* unit: it runs as your
# own user, needs no root, and writes nothing outside your home directory.
# It only keeps `nyra schedule daemon` running; the daemon itself
# checks the schedule every 60 seconds and runs due tasks (see
# `nyra schedule list` / `nyra schedule add`).
#
# Paths: the installed binary is assumed to be ~/.local/bin/nyra
# (ExecStart=%h/.local/bin/nyra). scripts/install-node.sh --with-systemd
# copies this file and rewrites ExecStart to the real install location.

[Unit]
Description=Nyra scheduler daemon (runs scheduled tasks)
Documentation=https://github.com/js2005happy/nyra/blob/main/docs/linux-systemd.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/bin/nyra schedule daemon
Restart=on-failure
RestartSec=10
# Hardening: user service, no privileges to gain, nothing outside $HOME written.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=true

[Install]
WantedBy=default.target
