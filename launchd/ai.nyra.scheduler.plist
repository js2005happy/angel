<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nyra scheduler daemon, as a launchd user agent.

  Install: see docs/macos-install.md. This is a *user* agent: it runs as
  your own user, needs no root, and writes nothing outside your home
  directory. It only keeps `python3 -m nyra schedule daemon` running; the
  daemon itself checks the schedule every 60 seconds and runs due tasks
  (see `nyra schedule list` / `nyra schedule add`).

  Paths: `__NYRA_PYTHON__`, `__NYRA_PREFIX__` and `__NYRA_HOME__` are
  placeholders replaced by scripts/install-macos.sh at install time with
  the real python path, install dir and $HOME. Do not edit the installed
  copy by hand (reinstalling overwrites it).

  systemd mirror: this plist is the macOS equivalent of
  systemd/nyra-scheduler.service. WantedBy=default.target (start at login)
  becomes RunAtLoad=true; Restart=on-failure becomes
  KeepAlive/SuccessfulExit=false (restart only when the daemon exits with
  an error — the daemon loops internally, so a clean exit is not restarted).
  PYTHONUNBUFFERED=1 matches the systemd unit's Environment line.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.nyra.scheduler</string>
    <key>ProgramArguments</key>
    <array>
        <string>__NYRA_PYTHON__</string>
        <string>-m</string>
        <string>nyra</string>
        <string>schedule</string>
        <string>daemon</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__NYRA_PREFIX__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>__NYRA_HOME__/.nyra/logs/scheduler.out.log</string>
    <key>StandardErrorPath</key>
    <string>__NYRA_HOME__/.nyra/logs/scheduler.err.log</string>
</dict>
</plist>
